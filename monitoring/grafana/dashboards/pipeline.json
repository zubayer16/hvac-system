{
  "uid": "buildingpilot-pipeline",
  "title": "BuildingPilot \u00b7 pipeline",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Unique valid observations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "buildingpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "bp_valid_events",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Quarantined records",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "buildingpilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "bp_invalid_events",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consumer lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "buildingpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "bp_kafka_consumer_lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ingestion attempts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "buildingpilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(bp_ingestion_events_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pipeline failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "buildingpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "bp_pipeline_failures_total",
          "refId": "A"
        }
      ]
    }
  ]
}