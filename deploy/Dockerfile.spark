FROM apache/spark:3.5.7-python3
USER root
RUN curl -fsSL https://repo.maven.apache.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/1.9.2/iceberg-spark-runtime-3.5_2.12-1.9.2.jar -o /opt/spark/jars/iceberg-runtime.jar \
 && curl -fsSL https://repo.maven.apache.org/maven2/org/apache/iceberg/iceberg-aws-bundle/1.9.2/iceberg-aws-bundle-1.9.2.jar -o /opt/spark/jars/iceberg-aws.jar
COPY jobs /jobs
USER spark
