# Optional: copy to .env. No credentials required for this loopback-only demo.
BP_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
BP_KAFKA_TOPIC=buildingpilot.telemetry.v1
BP_KAFKA_FAULT_TOPIC=buildingpilot.faults.v1
BP_KAFKA_GROUP_ID=buildingpilot-ingestion-v1
BP_DATABASE=data/buildingpilot.db
BP_TRANSPORT=kafka
BP_ALLOWED_LATENESS_SECONDS=900
# Native uvicorn/worker commands read process environment, not .env automatically.
# Compose sets its container addresses explicitly in compose.yaml.
BP_LAKE_CATALOG=local
BP_LAKE_ROOT=data/lakehouse
BP_MODEL_ROOT=data/models
BP_PIPELINE_ROOT=data/runs
BP_TRAIN_SOURCE=synthetic
BP_TRAIN_EPOCHS=80
BP_FORCE_RETRAIN=0
BP_API_URL=http://127.0.0.1:8000
# Run python scripts/init_local.py to generate ignored local S3/Grafana credentials.
# Shared catalog mode also uses BP_CATALOG_URI and BP_S3_ENDPOINT.
